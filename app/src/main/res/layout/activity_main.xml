<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FF21242B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <include layout="@layout/page_tabs" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sessionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFB0B6C2"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/faders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/buttonsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/buttonsRow1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/buttonsRow2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyboardPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/holdButton"
                    style="@style/KeyboardBarToggle"
                    android:text="@string/hold" />

                <TextView
                    android:id="@+id/arpButton"
                    style="@style/KeyboardBarToggle"
                    android:layout_marginStart="8dp"
                    android:text="@string/arp" />

                <TextView
                    android:id="@+id/octaveDown"
                    style="@style/OctaveButton"
                    android:layout_marginStart="16dp"
                    android:text="@string/octave_down" />

                <TextView
                    android:id="@+id/keyboardRange"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#FFECEFF4"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/octaveUp"
                    style="@style/OctaveButton"
                    android:text="@string/octave_up" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/arpGroup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/arp_group"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:id="@+id/arpPatternCell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_pattern"
                        android:textColor="#FFB0B6C2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/arpPatternValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFECEFF4"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_tempo"
                            android:textColor="#FFB0B6C2"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/arpTempoValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFECEFF4"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/arpTempoBar"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:max="200"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:progress="80"
                        android:progressBackgroundTint="#FF3A3F4A"
                        android:progressTint="@color/accent"
                        android:splitTrack="false"
                        android:thumbTint="@color/accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/arpRateCell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rate"
                        android:textColor="#FFB0B6C2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/arpRateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFECEFF4"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/arpOctavesCell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_octaves"
                        android:textColor="#FFB0B6C2"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/arpOctavesValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFECEFF4"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_gate"
                            android:textColor="#FFB0B6C2"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/arpGateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFECEFF4"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/arpGateBar"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:max="80"
                        android:minHeight="0dp"
                        android:paddingStart="0dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:progress="40"
                        android:progressBackgroundTint="#FF3A3F4A"
                        android:progressTint="@color/accent"
                        android:splitTrack="false"
                        android:thumbTint="@color/accent" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/keyboardContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/padsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lfosPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/xyPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
