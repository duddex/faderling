<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:measureWithLargestChild="true"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tabFaders"
        style="@style/PageTab"
        android:text="@string/page_faders" />

    <TextView
        android:id="@+id/tabButtons"
        style="@style/PageTab"
        android:text="@string/page_buttons" />

    <TextView
        android:id="@+id/tabKeyboard"
        style="@style/PageTab"
        android:text="@string/page_keyboard" />

    <TextView
        android:id="@+id/tabPads"
        style="@style/PageTab"
        android:text="@string/page_pads" />

    <TextView
        android:id="@+id/tabLfos"
        style="@style/PageTab"
        android:text="@string/page_lfos" />

    <TextView
        android:id="@+id/tabXy"
        style="@style/PageTab"
        android:text="@string/page_xy" />
</LinearLayout>
